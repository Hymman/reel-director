# ==========================================================
# Reel Director - Environment Configuration
# ==========================================================

# Parallel Search API (Server-side only, never exposed to client)
PARALLEL_API_KEY=your_parallel_api_key_here

# Google Cloud & Vertex AI Configuration
GOOGLE_CLOUD_PROJECT=your-google-cloud-project
GOOGLE_CLOUD_LOCATION=us-central1
GCS_BUCKET_NAME=your-private-gcs-bucket

# Gemini Model Configuration
GEMINI_MODEL_NAME=gemini-2.5-flash
IMAGE_MODEL_NAME=gemini-2.5-flash-image
USE_VERTEX_AI=true
# GEMINI_API_KEY= # Optional when USE_VERTEX_AI=false. Never commit a real value.

# Veo Video Generation Model
VEO_MODEL_NAME=veo-3.1-fast-generate-001

# Application Server
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
DEMO_MODE=true # Safe local default. Set false only with configured server-side providers.
# Local: workspace-scoped Range proxy. Production: short-lived private GCS V4 URLs.
MEDIA_DELIVERY_MODE=proxy
